# Pixel Corp — configuração. Copie para .env e ajuste.
# Sem nada configurado: o escritório pede a chave da OpenAI na tela inicial (ou
# roda em simulação), PGlite (Postgres embutido), barramento em memória e
# Temporal dev server local (baixado automaticamente).

# ---------------------------------------------------------------- modelos
# Jeito fácil: não mexa aqui. Abra o escritório e cole sua chave da OpenAI na tela
# inicial; ela fica em .env.local (fora do git) e liga o modo real na hora.
# LLM_PROVIDER fixa o modo e desliga essa tela: "sim" (simulação, nada cobrado) ou
# "openai" (cobrado na sua conta até o teto de cada missão, com OPENAI_API_KEY;
# é o caminho para servidores e Docker Compose). Configure também o spend limit
# do projeto na OpenAI.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_PROJECT=proj_...
# Trabalho braçal: toolloop (Responses API + sandbox) ou agents (Agents API, beta, sandbox hospedada)
# WORKER_RUNTIME=toolloop
# Sandbox no modo real: docker (sem rede; padrão quando o Docker está no ar) ou
# local (só `node`, ambiente sem chaves; usado sozinho quando o Docker está fora)
# SANDBOX=docker
# SANDBOX_IMAGE=node:22-alpine
# Velocidade da simulação (2 = duas vezes mais rápido)
# SIM_SPEED=1

# ---------------------------------------------------------------- infraestrutura
# Sem DATABASE_URL usa PGlite em .data/pglite (um processo só).
# DATABASE_URL=postgres://office:office@localhost:5432/office
# Sem REDIS_URL o barramento é em memória (API e worker no mesmo processo).
# REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=pixel-office
TEMPORAL_UI_URL=http://localhost:8233
# Worker dentro da API (obrigatório com PGlite). Com Postgres+Redis pode separar.
# EMBED_WORKER=true

# ---------------------------------------------------------------- API
HOST=127.0.0.1
PORT=4000
# Exigido ao expor numa VPS: o painel pede o token.
# OFFICE_TOKEN=um-segredo-comprido

# ---------------------------------------------------------------- receita (merchant-of-record, chave SÓ de leitura)
# POLAR_ACCESS_TOKEN=
# POLAR_ORGANIZATION_ID=
# POLAR_SERVER=production
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# PADDLE_API_KEY=
# PADDLE_SANDBOX=false
# Taxa estimada do MoR quando a API não informa o líquido
# MOR_FEE_PCT=0.05
# MOR_FEE_FIXED_USD=0.5
# FINANCE_POLL_SECONDS=900
# STAGNATION_MINUTES=1440

# ---------------------------------------------------------------- growth e pesquisa
# POSTHOG_HOST=https://us.posthog.com
# POSTHOG_PROJECT_ID=
# POSTHOG_PERSONAL_API_KEY=
# TAVILY_API_KEY=
# FIRECRAWL_API_KEY=

# ---------------------------------------------------------------- repositório remoto (opcional)
# Cada tarefa vira PR de verdade; o GitHub Actions roda o mesmo ci.json.
# GITHUB_TOKEN=
# GITHUB_REPO=sua-org/seu-produto
# Comando executado quando o Conselho aprova "deploy" (modo real)
# DEPLOY_COMMAND=

# ---------------------------------------------------------------- observabilidade
# Langfuse self-hosted via OpenTelemetry (OTLP)
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# ou qualquer coletor OTLP:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
